# 本番サイトのURL（OGPやsitemapの絶対URLに使用）
NEXT_PUBLIC_SITE_URL=https://zeical.jp

# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）。未設定なら計測は無効
NEXT_PUBLIC_GA_ID=

# Google AdSense のパブリッシャーID（ads.txt の pub-... と一致させる）
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5820360156544018

# 広告ユニットのスロットID（数字のみ。空ならその枠は表示しない）
# AdSense管理画面 > 広告 > 広告ユニット で発行した ID を入れる。
# 架空のIDは入れないこと。未設定のままデプロイして問題ない。
#
# Vercel（プロジェクト名: zeical）での設定:
# 1. AdSense でユニットを作る（計算結果下 / 下部固定 / 記事下）
# 2. Project Settings > Environment Variables に下記3つを追加（Production / Preview）
# 3. 再デプロイする（NEXT_PUBLIC_* はビルド時に埋め込まれるため必須）
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# 運営者の連絡先メール（運営者情報・プライバシーポリシーに表示）
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase（記事・コンテンツ管理）。未設定の場合はサンプル記事で動作します
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role（日次バッチのDB書き込み用。サーバー側のみ）
SUPABASE_SERVICE_ROLE_KEY=

# 楽天市場API（返礼品データ取得・2026年版）
# ※楽天デベロッパー > アプリ設定 >「許可されたWebサイト」に https://zeical.jp を登録すること
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID（API登録時に発行）。Vercelの環境変数に設定し再デプロイ
# → 楽天ふるさと納税ボタンがアフィリエイトリンクになり、API検索にも affiliateId が付く
RAKUTEN_AFFILIATE_ID=

# 各ふるさと納税ポータルのアフィリエイトタグ
# ふるなび（バリューコマース）は affiliate-config.ts に pid=892658067 を固定済み。
# バナー画像は public/images/affiliates/furunavi-banner.png（VC gifbanner は img src に使わない）
SATOFURU_AFFILIATE_TAG=
YAHOO_AFFILIATE_TAG=

# Vercel Cron認証用（ランダムな文字列を設定）
CRON_SECRET=
